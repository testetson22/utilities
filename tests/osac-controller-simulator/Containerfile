FROM registry.access.redhat.com/ubi9/go-toolset:1.25.5 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN GOTOOLCHAIN=local go mod download
COPY main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /tmp/osac-controller-simulator .
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
COPY --from=builder /tmp/osac-controller-simulator /usr/local/bin/osac-controller-simulator
ENTRYPOINT ["/usr/local/bin/osac-controller-simulator"]
